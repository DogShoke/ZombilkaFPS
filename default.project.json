{
  "name": "ZombilkaFPS",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",

      "Shared": {
        "$path": "src/shared"
      },

      "Assets": {
        "$className": "Folder",

        "FpsGlock": {
          "$path": "assets/FpsGlock_GameTextured.rbxmx"
        },
        "Zombies": {
          "$path": "assets/zombies/roblox"
        },
        "CityZombies": {
          "$path": "assets/zombies/generated/roblox"
        },
        "WeaponMotion": {
          "$path": "assets/weapons/motion"
        },
        "FpsAKM": {
          "$path": "assets/weapons/roblox/FpsAKM.rbxmx"
        },
        "FpsMossberg": {
          "$path": "assets/weapons/roblox/FpsMossberg.rbxmx"
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "LoadCharacterAppearance": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
